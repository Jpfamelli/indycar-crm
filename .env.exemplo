# ============================================================
# IndyCar CRM — configuração
#
# COMO USAR:
#   1. Faça uma cópia deste arquivo com o nome  .env
#   2. Preencha os valores abaixo
#   3. Rode:  node server.js
#
# Não precisa de setx, nem de mexer no Registro do Windows.
# ============================================================

# ---- Banco na nuvem (compartilhado com a Agenda) ----
# Deixe as duas linhas em branco (ou apague) para usar o banco local (crm.db).
SUPABASE_URL=https://nppfqhavqahapmugnyng.supabase.co

# Pegue em: Supabase > Project Settings > API Keys > service_role (botão "Reveal")
# ATENÇÃO: essa chave ignora as travas de segurança do banco.
# Ela fica só neste computador. Nunca coloque em site ou app de celular.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resumo semanal com IA ----
# Pegue em: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# ---- Opcionais ----
# PORT=3100
# CRM_HOST=127.0.0.1     # use 0.0.0.0 para acessar de outro aparelho da rede
# CRM_DB=sqlite          # força o banco local mesmo com o Supabase configurado
